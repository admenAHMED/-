model Provider {
  id        String    @id @default(cuid())
  name      String
  type      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
  payouts   Settlement[]

  @@map("providers")
}

model Service {
  id        String      @id @default(cuid())
  providerId String
  type      String
  name      String
  code      String      @unique
  basePrice Int
  currency  String      @default("USD")
  isActive  Boolean     @default(true)
  provider  Provider    @relation(fields: [providerId], references: [id])
  orders    OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("services")
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  orderNumber String      @unique
  status      String      @default("DRAFT")
  subtotal    Int
  fee         Int         @default(0)
  tax         Int         @default(0)
  total       Int
  currency    String      @default("USD")
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  invoices    Invoice[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("orders")
}

model Invoice {
  id        String   @id @default(cuid())
  orderId   String
  amount    Int
  currency  String   @default("USD")
  status    String   @default("DRAFT")
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model Settlement {
  id          String   @id @default(cuid())
  providerId  String
  amount      Int
  currency    String   @default("USD")
  status      String   @default("PENDING")
  provider    Provider @relation(fields: [providerId], references: [id])
  createdAt   DateTime @default(now())

  @@map("settlements")
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountCode String
  entryType   String
  amount      Int
  currency    String   @default("USD")
  description String?
  createdAt   DateTime @default(now())

  @@map("ledger_entries")
}

model CommissionRule {
  id          String   @id @default(cuid())
  name        String
  type        String
  rate        Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("commission_rules")
}
